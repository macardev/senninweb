{
  "trailingSlash": false,
  "redirects": [
    { "source": "/:path*/", "destination": "/:path", "permanent": true }
  ],
  "rewrites": [
    { "source": "/blog", "destination": "/index.html" },
    { "source": "/blog/:path*", "destination": "/index.html" },
    { "source": "/gebze", "destination": "/index.html" },
    { "source": "/sss", "destination": "/index.html" }
  ]
}
